# Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# GitHub (PAT with repo scope, or fine-grained token with Contents + Pull requests write)
GITHUB_TOKEN=
# Option A: owner/repo in one variable
GITHUB_REPOSITORY=owner/repo
# Option B: split variables (used if GITHUB_REPOSITORY is unset)
# GITHUB_OWNER=owner
# GITHUB_REPO=repo
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_BRANCH=main

# Target Vue repo on disk (absolute path on VPS)
TARGET_PROJECT_PATH=/path/to/your/vue-project

# Optional MCP debug logging
# MCP_DEBUG=1
